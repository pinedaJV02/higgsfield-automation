/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh wp14"><w:body><w:p w14:paraId="676113EC" w14:textId="658FB337" w:rsidR="001320D3" w:rsidRDefault="00462800"><w:r w:rsidRPr="00462800"><w:t>Full body 360, the stickman goes slowly turns in a circle and returns to the original position, I want the proportions kept and the stickman is not a 2d flat character but a 3d model, the style stays exactly the same</w:t></w:r></w:p><w:p w14:paraId="253869D6" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:t xml:space="preserve">Here’s a cleaned, structured version of your prompt with the added rules integrated and the contradictions resolved (notably removing any requirement for tools/props like flasks/clipboards since you want </w:t></w:r><w:r w:rsidRPr="00C41E6C"><w:rPr><w:i/><w:iCs/></w:rPr><w:t>no objects held</w:t></w:r><w:r w:rsidRPr="00C41E6C"><w:t>):</w:t></w:r></w:p><w:p w14:paraId="00410FB0" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:pict w14:anchorId="607E3D51"><v:rect id="_x0000_i1037" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="5B03775A" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Rewritten Prompt (Improved + Rule-Consistent):</w:t></w:r></w:p><w:p w14:paraId="2F069C2D" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:t>Keep the reference stickman exactly the same, preserving the oversized round head, moustache, eyebrows, eyes, stick limbs, thick outlines, and flat minimalist style.</w:t></w:r></w:p><w:p w14:paraId="2BA24277" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:t xml:space="preserve">The character must </w:t></w:r><w:r w:rsidRPr="00C41E6C"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>never hold, carry, or interact with any tools, props, or handheld objects</w:t></w:r><w:r w:rsidRPr="00C41E6C"><w:t xml:space="preserve"> under any circumstances.</w:t></w:r></w:p><w:p w14:paraId="0ADC9A16" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:t xml:space="preserve">Generate </w:t></w:r><w:r w:rsidRPr="00C41E6C"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>7 different versions of the same character</w:t></w:r><w:r w:rsidRPr="00C41E6C"><w:t>, each representing a different profession. Only the clothing and visual identity may change to reflect the profession, while the core design remains identical.</w:t></w:r></w:p><w:p w14:paraId="4C100313" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:t>Each version should clearly communicate a distinct profession through outfit and visual cues only (e.g., uniforms, coats, helmets, badges, hats), without introducing any objects in the character’s hands.</w:t></w:r></w:p><w:p w14:paraId="1D52DBE0" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:t>Examples of allowed variation:</w:t></w:r></w:p><w:p w14:paraId="0EC9F067" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Lab coat for scientist</w:t></w:r></w:p><w:p w14:paraId="74185297" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Suit for office worker</w:t></w:r></w:p><w:p w14:paraId="64256D61" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Scrubs for doctor</w:t></w:r></w:p><w:p w14:paraId="0AE20C44" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Apron for chef</w:t></w:r></w:p><w:p w14:paraId="1CFD4101" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Uniform for police officer</w:t></w:r></w:p><w:p w14:paraId="3AB394F6" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Helmet and vest for construction worker</w:t></w:r></w:p><w:p w14:paraId="166673CB" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Sports kit for athlete</w:t></w:r></w:p><w:p w14:paraId="7374DEBA" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Strict Design Constraints:</w:t></w:r></w:p><w:p w14:paraId="6591774F" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Only modify clothing and accessories worn on the body.</w:t></w:r></w:p><w:p w14:paraId="189B07B7" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t xml:space="preserve">The character must </w:t></w:r><w:r w:rsidRPr="00C41E6C"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>never hold items</w:t></w:r><w:r w:rsidRPr="00C41E6C"><w:t xml:space="preserve"> (no tools, no props, no devices, no paperwork, no instruments).</w:t></w:r></w:p><w:p w14:paraId="0E83AE2E" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Maintain the original proportions and minimalist stickman aesthetic.</w:t></w:r></w:p><w:p w14:paraId="6CBDE51D" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Anatomical Consistency Rules (Mandatory):</w:t></w:r></w:p><w:p w14:paraId="4C0B7189" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:t>The character must always have exactly:</w:t></w:r></w:p><w:p w14:paraId="6E0F731A" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>One head</w:t></w:r></w:p><w:p w14:paraId="61BFA095" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>One torso</w:t></w:r></w:p><w:p w14:paraId="0F8062F3" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Two arms</w:t></w:r></w:p><w:p w14:paraId="4B60D08E" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Two hands</w:t></w:r></w:p><w:p w14:paraId="5C2DADFA" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Two legs</w:t></w:r></w:p><w:p w14:paraId="5F783A38" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Two feet</w:t></w:r></w:p><w:p w14:paraId="225E4D7D" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:r w:rsidRPr="00C41E6C"><w:t>Never generate:</w:t></w:r></w:p><w:p w14:paraId="16CF7168" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Extra limbs or duplicated body parts</w:t></w:r></w:p><w:p w14:paraId="2F3E50B7" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Missing or merged limbs</w:t></w:r></w:p><w:p w14:paraId="04AB3D39" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Deformed anatomy</w:t></w:r></w:p><w:p w14:paraId="385864C9" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Detached body parts</w:t></w:r></w:p><w:p w14:paraId="321F4BE3" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Inconsistent proportions across versions or poses</w:t></w:r></w:p><w:p w14:paraId="75AF0746" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Style Consistency:</w:t></w:r></w:p><w:p w14:paraId="56B6F107" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Flat minimalist design</w:t></w:r></w:p><w:p w14:paraId="43498943" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="00C41E6C"><w:t>Thick clean outlines</w:t></w:r></w:p><w:p w14:paraId="7723A282" w14:textId="77777777" w:rsidR="00C41E6C" w:rsidRPr="00C41E6C" w:rsidRDefault="00C41E6C" w:rsidP="00C41E6C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><